<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.study</groupId>
        <artifactId>java-spring-study</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <!--
      纯 Java 模块：不依赖 Spring，专注 Bouncy Castle（BC）密码学库。
      覆盖哈希、对称/非对称加密、MAC、数字签名、密钥管理与协商、国密 SM2/SM3/SM4。
      本模块不打可执行 jar，运行方式见 README。
    -->
    <artifactId>module-18-bouncy-castle</artifactId>
    <name>module-18-bouncy-castle</name>
    <description>Bouncy Castle 密码学：哈希、对称/非对称加密、MAC、数字签名、密钥管理与协商、国密 SM2/SM3/SM4</description>

    <dependencies>
        <!-- Bouncy Castle 轻量级密码学 API（核心算法实现） -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.80</version>
        </dependency>
        <!-- Bouncy Castle PKIX/CMS/EAC/PKCS 等高级 API（证书、PEM 编码等） -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcpkix-jdk18on</artifactId>
            <version>1.80</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
